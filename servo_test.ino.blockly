<xml xmlns="https://developers.google.com/blockly/xml"><block type="arduino_setup" id="C^ltB7Sv8YE^q8@n?8?7" x="20" y="20"><statement name="SETUP"><block type="serial_begin" id="4iaNCo4z+JfX`z.7=zRw"><field name="BAUD">115200</field><next><block type="raw_code" id="~:UePO8t8if:3T;]Eo4W"><value name="CODE"><block type="text" id="Z{_xmNn9Mwz6/ReUz.d8"><field name="TEXT">WiFi.config(staticIP, gateway, subnet)</field></block></value><next><block type="raw_code" id=":n1N/+K$bza_Pw{AlPUP"><value name="CODE"><block type="text" id="U{e/_Gsv2cm:{Tj$1LIR"><field name="TEXT">WiFi.begin(SSID, PASSWORD)</field></block></value><next><block type="serial_print" id="8f7@*;yJ-FmnBFX:(t7T"><value name="TEXT"><block type="text" id="khMBrny?S0Bt;Kmd*zLx"><field name="TEXT">Connecting to WiFi</field></block></value><next><block type="raw_code" id="+(BINl4_ItbZtI)rp-r@"><value name="CODE"><block type="text" id="?r,-bE2o;^{5]))4!bsg"><field name="TEXT">while (WiFi.status() != WL_CONNECTED) {</field></block></value><next><block type="delay_ms" id=")a[coEhbOL{yy+X[zGW`"><value name="MS"><block type="math_number" id=",el~3iCm:zKFcKugjy54"><field name="NUM">500</field></block></value><next><block type="serial_print" id="I$e/yh4Q*db4FDQ9:pl_"><value name="TEXT"><block type="text" id="xl;-%.bS!?4)}dUVm{GU"><field name="TEXT">.</field></block></value><next><block type="raw_code" id="?s6]1H48wMA#}g,dCgTB"><value name="CODE"><block type="text" id="E+_Bm@e`R$~XR(Nbw0%L"><field name="TEXT">Serial.printf("\nConnected. IP: %s\n", WiFi.localIP().toString().c_str())</field></block></value><next><block type="raw_code" id="[kWD3Z*+*tBDT^dksT|f"><value name="CODE"><block type="text" id="]4K:)^5RfUz#O_DXaYW{"><field name="TEXT">prefs.begin("servo", false)</field></block></value><next><block type="raw_code" id="y{/4!j`WKUHaWk.fnPo("><value name="CODE"><block type="text" id="NHSo*Q48_S*(tG0DqM2d"><field name="TEXT">pos = prefs.getInt("pos", -1)</field></block></value><next><block type="raw_code" id="WmDh@hy=BG}nLVKw:JDN"><value name="CODE"><block type="text" id="T|9u3M?^t(MS_=66n.YI"><field name="TEXT">Serial.printf("Restored position: %d deg\n", pos)</field></block></value><next><block type="raw_code" id="0SRdWXknCvA^@@Wx`zkz"><value name="CODE"><block type="text" id="zpPDe7/Y{TJV2BhMJ{,%"><field name="TEXT">server.on("/left",  HTTP_GET, handleLeft)</field></block></value><next><block type="raw_code" id="c#AwXO5F)JDEx`s{=b1N"><value name="CODE"><block type="text" id="x0BXytWQJShKnzHb?9=h"><field name="TEXT">server.on("/right", HTTP_GET, handleRight)</field></block></value><next><block type="raw_code" id="$|E+#SW(NR;FCQ1#Bzhf"><value name="CODE"><block type="text" id="WN9wGHCk_O(gR[5[`Ek/"><field name="TEXT">server.begin()</field></block></value><next><block type="serial_println" id="L)c{KLkV5%k:t|t*A.8/"><value name="TEXT"><block type="text" id="kY@n]yh9Qi2]:y6`f[q9"><field name="TEXT">HTTP server started on port 80</field></block></value></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></statement></block><block type="arduino_loop" id="eC4Q-N?InbsBtx.^AByv" x="20" y="220"><statement name="LOOP"><block type="raw_code" id="I`^cgWF|RVY8ddTGB_k8"><value name="CODE"><block type="text" id="nFA^sW|Hhpv@N=ya[K@}"><field name="TEXT">server.handleClient()</field></block></value></block></statement></block></xml>